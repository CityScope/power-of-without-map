# Local SQLite file used by Prisma. Do not commit the database file.
DATABASE_URL="file:./dev.db"

# Present in the local environment file. Current application code does not read this variable.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Optional. Thunderforest cycle-map tiles. Leave empty to use standard OpenStreetMap tiles.
NEXT_PUBLIC_THUNDERFOREST_API_KEY=

# Optional. Set to true only in local development to show atlas debug overlays.
NEXT_PUBLIC_SHOW_ATLAS_DEBUG=

# Optional. Sent as the HDX HAPI app-identifier header when set. Leave empty to omit the header.
HDX_HAPI_APP_IDENTIFIER=
